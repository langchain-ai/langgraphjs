{
  "name": "@langchain/react",
  "version": "2.0.0-rc.1",
  "description": "React integration for LangGraph & LangChain",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist/ dist-cjs/",
    "build": "pnpm turbo build:internal --filter=@langchain/react",
    "build:internal": "pnpm --filter @langchain/build compile @langchain/react",
    "prepublish": "pnpm build",
    "lint:eslint": "NODE_OPTIONS=--max-old-space-size=4096 eslint --cache --ext .ts,.js,.jsx,.tsx src/",
    "test": "vitest run",
    "test:parity": "vitest run --project parity"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/langchain-ai/langgraphjs.git",
    "directory": "libs/sdk-react"
  },
  "dependencies": {
    "@langchain/langgraph-sdk": "workspace:*"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "workspace:^",
    "@langchain/langgraph-api": "workspace:^",
    "@langchain/langgraph-checkpoint": "workspace:^",
    "@types/node": "^25.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-webdriverio": "^4.1.11",
    "deepagents": "^1.10.5",
    "langchain": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "vitest-browser-react": "^2.3.0",
    "webdriverio": "^9.25.0",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@langchain/core": "^1.1.48",
    "react": "^18 || ^19"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "input": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ]
}
